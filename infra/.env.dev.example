# Copy this file to infra/.env.dev and adjust values for your machine.
# infra/.env.dev is gitignored — never commit real credentials.

# --- mysql ---
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=apartmaster
MYSQL_USER=apartmaster
MYSQL_PASSWORD=apartmaster123

# --- phpmyadmin (web UI for the mysql container) ---
# no extra vars needed; it reads PMA_HOST/PMA_PORT set directly in the compose file
